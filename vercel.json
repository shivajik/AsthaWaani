{
  "framework": "nextjs",
  "buildCommand": "next build --webpack && node scripts/fix-cjs-launcher.mjs",
  "outputDirectory": ".next",
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "asthawaani.com" }], "destination": "https://www.asthawaani.com/:path*", "permanent": true }
  ]
}

{
  "version": 2,
  "buildCommand": "npx vite build",
  "installCommand": "npm install",
  "outputDirectory": "dist/public",
  "framework": "vite",
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "asthawaani.com" }], "destination": "https://www.asthawaani.com/:path*", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.ts" },
    { "source": "/robots.txt", "destination": "/api/index.ts" },
    { "source": "/sitemap.xml", "destination": "/api/index.ts" },
    { "source": "/:path*", "has": [{ "type": "header", "key": "user-agent", "value": ".*(bot|crawl|spider|facebookexternalhit|WhatsApp|Twitterbot|LinkedInBot|Slurp|Googlebot|Bingbot|GPTBot|ClaudeBot|PerplexityBot|TelegramBot).*" }], "destination": "/api/index.ts" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
